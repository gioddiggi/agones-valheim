# =============================================================================
# Valheim Server
# =============================================================================

# Name displayed in the server browser
SERVER_NAME=My Server

# UDP port the Valheim server listens on
SERVER_PORT=2456

# World name, without the .db/.fwl extension
WORLD_NAME=Dedicated

# Server password (minimum 5 characters)
SERVER_PASS=secret

# Whether the server is listed in the public server browser
SERVER_PUBLIC=true

# Additional Valheim server CLI arguments
SERVER_ARGS=


# =============================================================================
# Access Control
# =============================================================================

# Space-separated list of SteamIDs to grant admin privileges
# Overrides any existing adminlist.txt entries
ADMINLIST_IDS=

# Space-separated list of SteamIDs to ban
# Overrides any existing bannedlist.txt entries
BANNEDLIST_IDS=

# Space-separated list of SteamIDs allowed to join
# Overrides any existing permittedlist.txt entries
PERMITTEDLIST_IDS=


# =============================================================================
# Updates
# =============================================================================

# Cron schedule for checking for server updates
# Empty value disables automatic update checks
UPDATE_CRON=*/15 * * * *

# Only check for updates when no players are connected
UPDATE_IF_IDLE=true


# =============================================================================
# Server Restarts
# =============================================================================

# Cron schedule for automatic server restarts
# Empty value disables automatic restarts
RESTART_CRON=0 5 * * *

# Only restart when no players are connected
RESTART_IF_IDLE=true


# =============================================================================
# Time Zone
# =============================================================================

# Container time zone
TZ=Etc/UTC


# =============================================================================
# Backups
# =============================================================================

# Enable periodic world backups
BACKUPS=true

# Cron schedule for world backups
# Empty value disables automatic backups
BACKUPS_CRON=0 * * * *

# Directory where backups are stored
BACKUPS_DIRECTORY=/config/backups

# Delete backups older than this many days
BACKUPS_MAX_AGE=3

# Maximum number of backups to keep
# 0 means unlimited
BACKUPS_MAX_COUNT=0

# Create backups even when no players are connected
BACKUPS_IF_IDLE=true

# Grace period in seconds after the last player disconnects
# Used when BACKUPS_IF_IDLE=false
BACKUPS_IDLE_GRACE_PERIOD=3600


# =============================================================================
# File Permissions
# =============================================================================

# Umask used when creating backups, config files and directories
PERMISSIONS_UMASK=022


# =============================================================================
# SteamCMD
# =============================================================================

# Additional SteamCMD command-line arguments
STEAMCMD_ARGS=validate


# =============================================================================
# Mods
# =============================================================================

# Enable ValheimPlus
# Cannot be used together with BEPINEX
VALHEIM_PLUS=false

# Enable BepInExPack Valheim
# Cannot be used together with VALHEIM_PLUS
BEPINEX=false


# =============================================================================
# Supervisor HTTP Server
# =============================================================================

# Enable Supervisor's HTTP server
SUPERVISOR_HTTP=false

# Supervisor HTTP server port
SUPERVISOR_HTTP_PORT=9001

# Supervisor HTTP username
SUPERVISOR_HTTP_USER=admin

# Supervisor HTTP password
SUPERVISOR_HTTP_PASS=


# =============================================================================
# Status HTTP Server
# =============================================================================

# Enable the status HTTP server
# Useful for public servers (SERVER_PUBLIC=true)
STATUS_HTTP=true

# TCP port used by the status HTTP server
STATUS_HTTP_PORT=80

# BusyBox httpd configuration file
STATUS_HTTP_CONF=/config/httpd.conf

# Directory containing the status page and generated status.json
STATUS_HTTP_HTDOCS=/opt/valheim/htdocs


# =============================================================================
# Remote Syslog
# =============================================================================

# Remote syslog server hostname or IP
# Leave empty to disable remote syslog
SYSLOG_REMOTE_HOST=

# Remote syslog UDP port
SYSLOG_REMOTE_PORT=514

# When remote syslog is enabled, also keep logging locally
SYSLOG_REMOTE_AND_LOCAL=true


# =============================================================================
# User / Group
# =============================================================================

# UID used to run the Valheim server
PUID=0

# GID used to run the Valheim server
PGID=0
